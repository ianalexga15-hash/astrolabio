# Copia a .env o genera uno con: python -m bot.preparar
# Nunca subas .env al repositorio ni uses variables VITE para secretos.
BOT_ADMIN_KEY=
BOT_LLM_KEY=
# Opcionales
# BOT_OLLAMA_URL=http://127.0.0.1:11434
# BOT_LLM_MODEL=qwen3:4b-instruct
# BOT_PORT=8770
# BOT_DECISOR=llm
# BOT_DB=data/bot.sqlite3
# BOT_SIN_SUSPENDER=1  # el equipo no se suspende mientras corre el bot; la pantalla sí se apaga y gasta más batería

# Cuenta MEXC en solo lectura (etapa 3). Crea la clave en MEXC solo con «View Account Details» y «View Order Details»;
# nunca con Trade, Withdraw ni Transfer. Pega los valores aquí, no en el chat ni en otro archivo, y reinicia el bot.
# MEXC_API_KEY=
# MEXC_API_SECRET=
